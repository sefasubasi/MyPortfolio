@model Message
@{
    ViewData["Title"] = "MessageDetail";
    Layout = "~/Views/Layout/Index.cshtml";
}

<input type="hidden" asp-for="MessageId" />

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Deneyimler</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Mesaj Detayı</div>
					</div>
					<div class="card-body">
						<div class="card-sub">
                            Gönderen: @Model.NameSurname - Email: @Model.Email - Konu: @Model.Subject - Tarih: @Model.SendDate.ToShortDateString()
                            <br />
                            Mesaj: @Model.MessageDetail
						</div>
						<a href="/Message/Inbox" class="btn btn-secondary">Mesaj Listesine Geri Dön</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
